{
  "name": "tabdesk",
  "version": "0.5.0",
  "description": "Terminal workspace for Claude Code projects: a tab rail of terminals on the left, the active project on the right.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "./build/render-icons.sh",
    "build:editor": "esbuild renderer/files-entry.js --bundle --format=iife --global-name=TabDeskFiles --platform=browser --target=chrome126 --minify --legal-comments=none --outfile=renderer/files.bundle.js",
    "test:ui:files": "npm run build:editor && node test/ui-project-files.mjs",
    "postinstall": "electron-rebuild -f -w node-pty && npm run build:editor",
    "test": "npm run build:editor && node --test test/main-lifecycle.test.js test/project-files.test.js test/session-ownership.test.js test/file-state.test.js test/navigation.test.js test/tmux-test-environment.test.js test/disk-usage.test.js && electron test/editor-controller.js && electron test/renderer-session-controller.js && electron test/renderer-tab-wrap.js && electron test/root-reload-lifecycle.js && electron test/projects-root-transition.js && electron test/settings-atomic.js && node test/main-pending-starts-runner.js && electron test/main.js",
    "dist": "npm run build:editor && electron-builder --linux deb tar.gz",
    "prepare": "husky",
    "lint:complexity": "eslint ."
  },
  "author": {
    "name": "Andreas Thun"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/rebuild": "^3.6.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@fontsource/fira-code": "^5.3.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-progress": "^0.2.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^3.6.0",
    "node-pty": "^1.0.0",
    "ssh2": "^1.17.0"
  },
  "build": {
    "appId": "io.thern.tabdesk",
    "productName": "TabDesk",
    "files": [
      "main.js",
      "main-lifecycle.js",
      "session-ownership.js",
      "preload.js",
      "picker-preload.js",
      "portable-preload.js",
      "portable.js",
      "settings-preload.js",
      "sync/**",
      "update-preload.js",
      "updater.js",
      "preview-preload.js",
      "preview-runner.js",
      "term-embed.js",
      "theme.js",
      "tray.js",
      "i18n.js",
      "settings.js",
      "model.js",
      "agents.js",
      "effort.js",
      "history.js",
      "transcript.js",
      "opencode-store.js",
      "kimi-store.js",
      "kimi-limits.js",
      "codex-limits.js",
      "disk-usage.js",
      "activity.js",
      "asking.js",
      "projects-root.js",
      "project-files/**",
      "app-runner.js",
      "usage-worker.js",
      "usage-limits.js",
      "renderer/**",
      "themes/**",
      "i18n/**",
      "build/icon.png",
      "build/tray.png",
      "build/tray@2x.png",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "linux": {
      "target": [
        "deb",
        "tar.gz"
      ],
      "category": "Development;TerminalEmulator",
      "icon": "build/icons",
      "synopsis": "Terminal workspace for Claude Code projects",
      "desktop": {
        "entry": {
          "Name": "TabDesk",
          "Comment": "Terminal workspace for Claude Code projects",
          "Keywords": "terminal;claude;projects;development;",
          "StartupWMClass": "TabDesk"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libdbusmenu-glib4",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0",
        "xterm",
        "xdotool",
        "python3-gi"
      ]
    }
  },
  "homepage": "https://github.com/Detrol/tabdesk",
  "desktopName": "tabdesk.desktop"
}
