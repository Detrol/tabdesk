# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*

# Packaged output
dist/
out/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Runtime screenshots the app writes to ~/Pictures stay out of the repo anyway,
# but ignore any that land here during dev.
tabdesk-*.png

# Built APT repo (regenerated by deploy/build-apt-repo.sh)
deploy/repo/

# FTP credentials for the tabdesk.thern.io deploy (chmod 600, never committed)
deploy/.ftp.env

# Besöksdatabasen skapas av visitors.php och lever bara på servern
site/data/*.sqlite*

# Token som visitors.php läser — delad med thern.io:s övriga statistik-endpoints
site/stats-token.php
