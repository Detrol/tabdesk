# TabDesk environment template
#
# TabDesk does not load .env files automatically. To use this file during
# development, copy it to .env, fill in the values you need, and source it
# before starting the app:
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#   npm start
#
# Keep .env out of version control. Never commit access tokens.

# ---------------------------------------------------------------------------
# TabDesk
# ---------------------------------------------------------------------------

# Override the projects directory for this run. If unset, TabDesk uses the
# directory selected in Settings (or adopts ~/claude-projects on first run).
TABDESK_PROJECTS_DIR=

# Optional command for demo and UI testing instead of starting an agent CLI.
# Example: exec bash --noprofile --norc
TABDESK_START_CMD=

# ---------------------------------------------------------------------------
# Shell and locale
# ---------------------------------------------------------------------------

# Shell used for new terminal sessions. Defaults to /bin/bash.
SHELL=

# PATH is inherited from the shell so TabDesk can find installed agent CLIs.
# Do not set it to an empty value in .env; prepend directories in your shell
# profile instead if a CLI is not already on PATH.
# PATH=

# Optional XDG locations used by the agent session stores and TabDesk guard.
XDG_CONFIG_HOME=
XDG_DATA_HOME=
XDG_CACHE_HOME=

# Locale selection. TabDesk checks LANGUAGE, then LC_ALL, LC_MESSAGES, and
# LANG, and uses the matching file in i18n/ when one is available.
LANGUAGE=
LC_ALL=
LC_MESSAGES=
LANG=

# ---------------------------------------------------------------------------
# Agent data and credentials
# ---------------------------------------------------------------------------

# Optional locations for agent data. Leave unset to use each CLI's default.
KIMI_CODE_HOME=
GROK_HOME=

# Optional Claude Code OAuth token used for usage lookup. Prefer authenticating
# with Claude Code itself; only set this when a token is already available.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional Kimi Code OAuth token used for usage lookup.
KIMI_CODE_OAUTH_TOKEN=

# Kimi Code API and OAuth endpoint overrides. The defaults are:
# https://api.kimi.com/coding/v1 and https://auth.kimi.com
KIMI_CODE_BASE_URL=
KIMI_CODE_OAUTH_HOST=
# Legacy alias accepted by Kimi Code integrations:
KIMI_OAUTH_HOST=

# Kimi Code thinking effort, when selecting a Kimi session. Typical values
# depend on the installed Kimi Code CLI (for example: low, medium, high).
KIMI_MODEL_THINKING_EFFORT=

# ---------------------------------------------------------------------------
# Development and test isolation
# ---------------------------------------------------------------------------

# Put tmux sockets in an isolated directory when running UI/integration tests.
TMUX_TMPDIR=

# Scratch directory used by the pending-starts test harness.
TABDESK_PENDING_STARTS_SCRATCH=

# Internal marker set by TabDesk for its monitor process. Do not set manually.
# TABDESK_MONITOR=
